# Classic personal access token with the notifications scope.
GITHUB_TOKEN=replace-with-classic-token

# Optional fine-grained token with Pull requests: read access for this owner.
# GITHUB_TOKEN_ACME_CORP=replace-with-owner-token

# Mode for every repository not listed below: log, read or done.
MODE=log

# Optional comma-separated owners or owner/repo entries that use another mode.
# A repository entry beats its owner's entry. Do not quote the values.
# MODE_DONE=acme-corp,other-org/noisy-repo
# MODE_READ=some-org
# MODE_LOG=acme-corp/critical-service

POLL_INTERVAL=60s
